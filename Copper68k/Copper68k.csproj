<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1701;1702;NU1900</NoWarn>
    <PackageId>Copper68k</PackageId>
    <Title>Copper68k</Title>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Reusable Motorola 68000-family CPU emulation core with cycle-aware interpreter backends and an opt-in MC68040 JIT.</Description>
    <Version>1.5.2</Version>
    <PackageVersion>1.5.2</PackageVersion>
    <PackageReleaseNotes>Development candidate: completes synthetic MOVE/MOVEA, transfer/address and arithmetic/comparison milestones across seven CPU models and A1200 EC020 with 2945168 deterministic logical cases. Adds remaining arithmetic EAs, full indexed arithmetic, memory ADDX/SUBX and PACK/UNPK. Fixes active stack-bank updates, decimal operand alias ordering, signed word division overflow and model-specific divide-by-zero frames and returns. Earlier MOVE/MOVEM, address-width and partial-execution fixes are retained. Logical/bit/shift and control/system milestones and cross-model external qualification remain untested. Existing admitted brief timing policies remain approximate; physical timing is not qualified. This version is unpublished until explicitly released.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ilehtoranta/CopperMod</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilehtoranta/CopperMod.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageTags>emulation;m68000;m68k;68000;68ec020;68020;68030;68040;68060;cpu;jit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>copper68k-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>$(NoWarn);1701;1702;NU1900</NoWarn>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>$(NoWarn);1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="copper68k-icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotPathGuard.Analyzers" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.303" PrivateAssets="All" />
    <PackageReference Include="CopperFloat" Version="[1.0.0]" />
  </ItemGroup>

</Project>
