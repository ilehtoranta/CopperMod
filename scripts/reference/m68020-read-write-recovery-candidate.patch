+    // Isolated development. The selected simple MOVE suffix can resume;
+    // other pending operations remain explicit unsupported continuations.
+    private const ushort OperandReadContext020 = 0xc022;
+    private readonly bool _has020PhysicalMap;
+    private bool _entering020ReadFault;
+    private bool _resumingMoveRead020, _readingTraceVector020;
+    private ushort? _restoredOperandFunctionCode020;
+    private enum PendingReadKind020 : ushort { Unknown, MoveSource, TraceVector, MoveIndexedSource, MoveIndexedPointer }
