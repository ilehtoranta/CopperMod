+        uint PointerOffset, PendingReadKind020 Kind);
+    private IndexedReadContext020 _indexedReadContext020;
+
+    private uint ReadIndexedMoveSource020(uint baseAddress, ushort extension, ushort opcode, M68kInstructionTimingKey timingKey)
+    {
+        var previous = _indexedReadContext020;
+        _indexedReadContext020 = new(extension, timingKey, 0, PendingReadKind020.MoveIndexedSource);
+        try
+        {
+            var address = CalculateIndexedOperandAddress(baseAddress, extension, opcode);
+            var top = opcode >> 12;
+            return ReadSized(address, top == 1 ? M68kOperandSize.Byte : top == 3 ? M68kOperandSize.Word : M68kOperandSize.Long);
+        }
+        finally { _indexedReadContext020 = previous; }
+    }
+
+    private uint ReadIndexedPointer020(uint address, uint pointerOffset)
+    {
+        if (_indexedReadContext020.Kind != PendingReadKind020.MoveIndexedSource) return ReadLong(address);
+        var previous = _indexedReadContext020;
+        _indexedReadContext020 = previous with { Kind = PendingReadKind020.MoveIndexedPointer, PointerOffset = pointerOffset };
+        try { return ReadLong(address); }
+        finally { _indexedReadContext020 = previous; }
+    }
+
+    private uint ReadPendingIndexed020(uint address, M68kOperandSize size, IndexedReadContext020 context)
+    {
+        var previous = _indexedReadContext020; _indexedReadContext020 = context;
+        try { return ReadPendingMoveSource020(address, size); }
+        finally { _indexedReadContext020 = previous; }
+    }
+
+    private sealed class OperandReadFault020(uint address, int width, uint instructionPc,
+        uint nextPc, ushort opcode, uint guestStack, M68kAdvancedInstructionPipe pipe, PendingReadKind020 kind, int indexedExtraCycles, ushort functionCode, IndexedReadContext020 indexedContext) :
