+    {
+        internal readonly uint Address = address, InstructionPc = instructionPc, NextPc = nextPc, GuestStack = guestStack;
+        internal readonly int Width = width;
+        internal readonly ushort Opcode = opcode;
+        internal readonly M68kAdvancedInstructionPipe Pipe = pipe;
+        internal readonly PendingReadKind020 Kind = kind;
+        internal readonly int IndexedExtraCycles = indexedExtraCycles;
+        internal readonly ushort FunctionCode = functionCode;
+        internal readonly IndexedReadContext020 IndexedContext = indexedContext;
+    }
+
