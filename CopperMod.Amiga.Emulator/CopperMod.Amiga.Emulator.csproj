<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\CopperStartIntegration.props" />
  <Import Project="$(CopperStartHostSourceRoot)\CopperStart.CopperMod.projitems"
          Condition="Exists('$(CopperStartHostSourceRoot)\CopperStart.CopperMod.projitems')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>CopperMod.Amiga.Emulator</PackageId>
    <Title>CopperMod.Amiga.Emulator</Title>
    <Authors>Ilkka Lehtoranta</Authors>
    <Description>Full Amiga emulator host services, boot helpers, and disk media adapters layered on CopperMod.Amiga.</Description>
    <PackageVersion>1.1.1-dev.1</PackageVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ilehtoranta/CopperMod</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ilehtoranta/CopperMod.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>amiga;emulation;adf;ipf;scp;disk;boot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Development source ownership move: replacement-OS services and boot orchestration are maintained in CopperStart; emulator host contracts remain unchanged.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CopperDisk" Version="[2.1.1-boundary.1]" />
    <ProjectReference Include="..\CopperMod.Amiga\CopperMod.Amiga.csproj" />
    <ProjectReference Include="..\CopperMod.Amiga.CyberGraphics\CopperMod.Amiga.CyberGraphics.csproj" />
    <ProjectReference Include="..\Copper68k\Copper68k.csproj" />
  </ItemGroup>

  <Target Name="RequireCopperStartHostSources" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(CopperStartHostSourceRoot)\CopperStart.CopperMod.projitems')">
    <Error Text="CopperStart host sources are required. Check out CopperStart beside CopperMod or set CopperStartRoot to its absolute checkout path." />
  </Target>

</Project>
