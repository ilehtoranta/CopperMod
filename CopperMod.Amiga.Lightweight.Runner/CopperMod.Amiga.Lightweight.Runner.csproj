<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(LightweightReferencePath)' == ''">
    <ProjectReference Include="..\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LightweightReferencePath)' != ''">
    <Reference Include="CopperMod.Amiga.Lightweight" HintPath="$(LightweightReferencePath)" Private="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Copper68k\Copper68k.csproj" />
  </ItemGroup>
</Project>
