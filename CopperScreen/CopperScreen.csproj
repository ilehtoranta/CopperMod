<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>CopperScreen</PackageId>
    <Version>1.1.3</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <InformationalVersion>1.1.3</InformationalVersion>
    <Title>CopperScreen</Title>
    <Authors>CopperMod contributors</Authors>
    <Description>Slim Amiga 500 PAL emulator front-end backed by CopperMod.Amiga.</Description>
    <ApplicationIcon>Assets\CopperScreen.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- Keep source-mode development available until packages are published. -->
    <UseEmulatorProjectReferences Condition="'$(UseEmulatorProjectReferences)' == ''">true</UseEmulatorProjectReferences>
    <LightweightPackageVersion Condition="'$(LightweightPackageVersion)' == ''">0.1.0-preview.1</LightweightPackageVersion>
    <Copper68kBoundaryVersion Condition="'$(Copper68kBoundaryVersion)' == ''">1.4.1-boundary.1</Copper68kBoundaryVersion>
    <CopperDiskBoundaryVersion Condition="'$(CopperDiskBoundaryVersion)' == ''">2.1.1-boundary.1</CopperDiskBoundaryVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="CopperPad" Version="2.0.0-preview.1" />
    <PackageReference Include="CopperPad.HidSharp" Version="2.0.0-preview.1" />
    <PackageReference Include="HotPathGuard.Abstractions" Version="0.1.0" />
    <PackageReference Include="HotPathGuard.Analyzers" Version="0.1.0" PrivateAssets="all" />
    <PackageReference Include="Miniaudio-CS" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CopperDisk\CopperDisk.csproj" Condition="'$(UseEmulatorProjectReferences)' == 'true'" />
    <ProjectReference Include="..\Copper68k\Copper68k.csproj" Condition="'$(UseEmulatorProjectReferences)' == 'true'" />
    <ProjectReference Include="..\CopperMod.Amiga.Lightweight\CopperMod.Amiga.Lightweight.csproj" Condition="'$(UseEmulatorProjectReferences)' == 'true'" />
    <PackageReference Include="CopperMod.Amiga.Lightweight" Version="[$(LightweightPackageVersion)]" Condition="'$(UseEmulatorProjectReferences)' != 'true'" />
    <PackageReference Include="Copper68k" Version="[$(Copper68kBoundaryVersion)]" Condition="'$(UseEmulatorProjectReferences)' != 'true'" />
    <PackageReference Include="CopperDisk" Version="[$(CopperDiskBoundaryVersion)]" Condition="'$(UseEmulatorProjectReferences)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Profiles\*.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\CopperScreen.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <!-- Legacy/CopperStart restoration is separate from the native host build. -->
    <Compile Remove="CopperScreenEmulator.cs;CopperBenchViewModel.cs;CopperScreenPresentationFrame.cs" />
  </ItemGroup>

  <Target Name="SetCopperStartAssemblyMetadata" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CopperStartGitSha" />
    </Exec>
    <PropertyGroup>
      <CopperStartGitSha Condition="'$(CopperStartGitSha)' == ''">unknown</CopperStartGitSha>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="CopperStartSha" Value="$(CopperStartGitSha)" />
    </ItemGroup>
  </Target>

</Project>
